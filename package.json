{
	"name": "confluence-integration-plus",
	"version": "1.2.0",
	"description": "Publish notes to Atlassian Confluence and pull changes made in Confluence back into your vault.",
	"private": true,
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src package.json",
		"fmt": "prettier --write \"src/**/*.ts\"",
		"fmt:check": "prettier --check \"src/**/*.ts\"",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Flyx",
	"license": "Apache-2.0",
	"dependencies": {
		"@electron/remote": "2.1.3",
		"@markdown-confluence/lib": "7.0.0",
		"@markdown-confluence/plantuml-renderer": "7.0.0",
		"effect": "4.0.0-rc.112",
		"node-diff3": "3.2.1"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.0-rc.112",
		"@eslint/js": "^9.30.1",
		"@types/node": "^24.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"mermaid": "^11.16.1",
		"obsidian": "1.13.1",
		"prettier": "^3.6.0",
		"typescript": "^5.9.0",
		"typescript-eslint": "^8.35.1",
		"vitest": "4.1.11"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.0-rc.112"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/FlyxHub/obsidian-integration-plus.git"
	},
	"bugs": {
		"url": "https://github.com/FlyxHub/obsidian-integration-plus/issues"
	}
}
